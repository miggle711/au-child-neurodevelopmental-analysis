{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Disability groups among children aged 0-14, Australia 2022",
  "description": "ABS SDAC 2022 (Children and Young People with Disability): % of all children aged 0-14 with each disability group, sorted highest to lowest (national data only). Replaced a radar/spider chart: these six categories have no natural circular order, so a radar's polygon area and shape would have implied a pattern that isn't in the data. A sorted lollipop shows the same six numbers honestly.",
  "width": 420,
  "height": 220,
  "data": {
    "url": "data/processed/abs_disability_groups_0_14.csv"
  },
  "encoding": {
    "y": {
      "field": "disability_group",
      "type": "nominal",
      "title": null,
      "sort": "-x"
    },
    "x": {
      "field": "pct",
      "type": "quantitative",
      "title": "% of all children aged 0-14"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#d9d1bd"
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "color": "#c4703f"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "disability_group",
            "title": "Disability group"
          },
          {
            "field": "pct",
            "title": "%",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "title": {
      "font": "Public Sans",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#2b2a26",
      "anchor": "start"
    },
    "axis": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "legend": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "header": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600
    }
  }
}
