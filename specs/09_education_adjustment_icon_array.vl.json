{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Students receiving an educational adjustment for disability, 2020",
  "description": "AIHW/NCCD: % of enrolled students who received an educational adjustment due to disability, shown two ways — by school sector and by level of adjustment (national data, two separate breakdowns, not a cross-tab)",
  "data": {"url": "data/processed/aihw_education_adjustment.csv"},
  "transform": [
    {"calculate": "sequence(0, 100)", "as": "seq"},
    {"flatten": ["seq"]},
    {"calculate": "datum.seq % 10", "as": "col"},
    {"calculate": "floor(datum.seq / 10)", "as": "row"},
    {"calculate": "datum.seq < round(datum.pct)", "as": "filled"}
  ],
  "facet": {
    "row": {"field": "group", "type": "nominal", "title": null, "header": {"labelFontSize": 13, "labelFontWeight": "bold"}}
  },
  "spec": {
    "width": 160,
    "height": 160,
    "facet": {
      "column": {
        "field": "category",
        "type": "nominal",
        "title": null,
        "header": {"labelFontSize": 10, "labelAngle": 0, "labelLimit": 100}
      }
    },
    "spec": {
      "width": 100,
      "height": 100,
      "mark": {"type": "square", "size": 60},
      "encoding": {
        "x": {"field": "col", "type": "ordinal", "axis": null},
        "y": {"field": "row", "type": "ordinal", "axis": null, "sort": "descending"},
        "color": {
          "field": "filled",
          "type": "nominal",
          "scale": {"domain": [true, false], "range": ["#d94801", "#f0f0f0"]},
          "legend": null
        },
        "tooltip": [
          {"field": "category", "title": "Category"},
          {"field": "pct", "title": "%"}
        ]
      }
    }
  },
  "resolve": {"scale": {"color": "independent"}}
}
