{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Developmental vulnerability by state/territory, 2024",
  "description": "AEDC: % of children developmentally vulnerable on one or more domains, by state/territory",
  "width": "container",
  "height": 664,
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/geo/au_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "au_states_raw"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/processed/aedc_state_2024.csv"
            },
            "key": "state",
            "fields": [
              "vulnerable_1plus_pct",
              "abbr"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "vulnerable_1plus_pct",
          "type": "quantitative",
          "title": ["% developmentally", "vulnerable"],
          "scale": {
            "scheme": "oranges"
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "titleLimit": 160,
            "gradientLength": 160
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State"
          },
          {
            "field": "vulnerable_1plus_pct",
            "title": "% vulnerable",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {"url": "data/processed/state_label_positions.csv"},
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "stroke": "white",
        "strokeWidth": 3,
        "strokeOpacity": 0.7
      },
      "encoding": {
        "longitude": {"field": "label_lon", "type": "quantitative"},
        "latitude": {"field": "label_lat", "type": "quantitative"},
        "text": {"field": "abbr", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/processed/state_label_positions.csv"},
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#2b2a26"
      },
      "encoding": {
        "longitude": {"field": "label_lon", "type": "quantitative"},
        "latitude": {"field": "label_lat", "type": "quantitative"},
        "text": {"field": "abbr", "type": "nominal"}
      }
    }
  ],
  "config": {
    "title": {
      "font": "Public Sans",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#2b2a26",
      "anchor": "start"
    },
    "axis": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "legend": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "header": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600
    }
  }
}
