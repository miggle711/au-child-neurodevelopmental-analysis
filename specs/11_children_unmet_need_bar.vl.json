{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Support needs met vs. not met, children with disability aged 0-14",
  "description": "ABS SDAC 2022 (Children and young people with disability): among children aged 0-14 who need assistance with an activity, the share whose need is fully met vs. not fully met, by activity type, sorted by highest unmet need (national data only, all disability types, not autism-specific)",
  "width": "container",
  "height": 220,
  "data": {
    "url": "data/processed/abs_children_unmet_need_0_14.csv"
  },
  "transform": [
    {
      "calculate": "datum.status === 'Need not met' ? datum.pct : 0",
      "as": "unmet_pct"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "unmet_pct",
          "as": "sort_pct"
        }
      ],
      "groupby": ["activity"]
    },
    {
      "filter": "datum.status === 'Need not met' || datum.status === 'Need met'"
    }
  ],
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,
      "sort": {
        "op": "max",
        "field": "sort_pct",
        "order": "descending"
      }
    },
    "x": {
      "field": "pct",
      "type": "quantitative",
      "title": "% of children with that need"
    },
    "yOffset": {
      "field": "status",
      "sort": ["Need not met", "Need met"]
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Need not met", "Need met"],
        "range": ["#c4703f", "#d9d1bd"]
      },
      "legend": {
        "orient": "bottom",
        "columns": 1
      }
    },
    "opacity": {
      "condition": {
        "param": "status_select",
        "value": 1
      },
      "value": 0.25
    }
  },
  "layer": [
    {
      "mark": "bar",
      "params": [
        {
          "name": "status_select",
          "select": {
            "type": "point",
            "fields": ["status"]
          },
          "bind": "legend"
        }
      ],
      "encoding": {
        "tooltip": [
          {
            "field": "activity",
            "title": "Activity"
          },
          {
            "field": "status",
            "title": "Status"
          },
          {
            "field": "pct",
            "title": "%",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],
  "config": {
    "title": {
      "font": "Public Sans",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#2b2a26",
      "anchor": "start"
    },
    "axis": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "legend": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "header": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600
    }
  }
}
