{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Developmental vulnerability by local area, 2024",
  "description": "AEDC: % of children developmentally vulnerable on one or more domains, by Local Government Area (proportional symbol map, 514 of 544 LGAs with matched centroids). Colour encodes the vulnerability rate; size encodes the number of children surveyed, so a small, high-rate LGA doesn't read as visually equivalent to a large one.",
  "width": "container",
  "height": 664,
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/geo/au_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "au_states_raw"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/processed/aedc_lga_2024_with_centroids.csv"
      },
      "transform": [
        {
          "filter": "datum.vulnerable_1plus_pct != null && datum.vulnerable_1plus_pct !== ''"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "black",
        "opacity": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "vulnerable_1plus_valid_n",
          "type": "quantitative",
          "title": "Children surveyed",
          "scale": {
            "range": [
              15,
              500
            ]
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "titleLimit": 160,
            "gradientLength": 160
          }
        },
        "color": {
          "field": "vulnerable_1plus_pct",
          "type": "quantitative",
          "title": ["% developmentally", "vulnerable"],
          "scale": {
            "scheme": "oranges"
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "titleLimit": 160,
            "gradientLength": 160
          }
        },
        "strokeWidth": {
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "lga_name",
            "title": "LGA"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "vulnerable_1plus_pct",
            "title": "% vulnerable",
            "format": ".1f"
          },
          {
            "field": "vulnerable_1plus_valid_n",
            "title": "Children surveyed"
          }
        ]
      }
    }
  ],
  "config": {
    "title": {
      "font": "Public Sans",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#2b2a26",
      "anchor": "start"
    },
    "axis": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "legend": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "header": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600
    }
  }
}
