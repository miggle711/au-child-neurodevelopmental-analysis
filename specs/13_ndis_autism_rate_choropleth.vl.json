{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "NDIS autism participants per 1,000 population, by state, Dec 2024",
  "description": "NDIS Data Research: active autism participants per 1,000 total population, by state/territory (all ages; population denominator is ABS Estimated Resident Population, 31 Dec 2024, exact date match). Genuinely autism-specific (not a general developmental-vulnerability proxy like the AEDC-based maps), but note this measures NDIS ACCESS/participation, which can reflect service availability as much as underlying prevalence.",
  "width": 440,
  "height": 350,
  "padding": {
    "top": 10,
    "left": 5,
    "right": 5,
    "bottom": 5
  },
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "data/geo/au_states.topo.json",
    "format": {
      "type": "topojson",
      "feature": "au_states_raw"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/processed/ndis_autism_rate_by_state.csv"
        },
        "key": "state",
        "fields": [
          "rate_per_1000",
          "abbr",
          "autism_ndis_participants"
        ]
      }
    }
  ],
  "params": [
    {
      "name": "state_select",
      "select": {
        "type": "point",
        "fields": [
          "properties.STATE_NAME"
        ],
        "empty": "none"
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "rate_per_1000",
      "type": "quantitative",
      "title": [
        "Autism NDIS",
        "participants",
        "per 1,000 people"
      ],
      "scale": {
        "range": [
          "#e3c4a8",
          "#c4703f",
          "#6b3a1f"
        ]
      },
      "legend": {
        "titleLimit": 140,
        "gradientLength": 180,
        "tickCount": 5
      }
    },
    "strokeWidth": {
      "condition": {
        "param": "state_select",
        "value": 2.5
      },
      "value": 1
    },
    "stroke": {
      "condition": {
        "param": "state_select",
        "value": "#6b7c5e"
      },
      "value": "white"
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State"
      },
      {
        "field": "rate_per_1000",
        "title": "Per 1,000 people"
      },
      {
        "field": "autism_ndis_participants",
        "title": "Total participants"
      }
    ]
  },
  "config": {
    "title": {
      "font": "Public Sans",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#2b2a26",
      "anchor": "start"
    },
    "axis": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "legend": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "header": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600
    }
  }
}
