{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Autistic children in Australia, 2015-2022",
  "description": "ABS SDAC: estimated number of autistic children, by age group and survey year (national data only)",
  "data": {"url": "../data/processed/abs_autism_trend.csv"},
  "width": 450,
  "height": 250,
  "mark": {"type": "area", "line": true, "opacity": 0.6},
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "title": "Survey year"},
    "y": {"field": "estimate_000", "type": "quantitative", "title": "Estimated number ('000)", "stack": true},
    "color": {
      "field": "age_group",
      "type": "nominal",
      "title": "Age group",
      "scale": {"range": ["#fdae6b", "#d94801"]}
    },
    "tooltip": [
      {"field": "age_group", "title": "Age group"},
      {"field": "year", "title": "Year"},
      {"field": "estimate_000", "title": "Estimate ('000)"}
    ]
  }
}
