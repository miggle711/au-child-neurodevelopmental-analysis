{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Schooling restriction among children with disability, 2018",
  "description": "AIHW/ABS SDAC: % of children aged 5-14 with a disability who have a schooling restriction, overall and by sex (bullet chart; national data only)",
  "data": {"url": "../data/processed/aihw_schooling_restriction.csv"},
  "width": 400,
  "height": 140,
  "layer": [
    {
      "mark": {"type": "bar", "size": 22, "color": "#e0e0e0"},
      "encoding": {
        "y": {"field": "group", "type": "nominal", "sort": ["All children", "Boys", "Girls"], "title": null},
        "x": {"datum": 12, "type": "quantitative", "title": "% with a schooling restriction"}
      }
    },
    {
      "mark": {"type": "bar", "size": 22, "color": "#fdae6b"},
      "encoding": {
        "y": {"field": "group", "type": "nominal", "sort": ["All children", "Boys", "Girls"]},
        "x": {"field": "pct", "type": "quantitative"},
        "tooltip": [
          {"field": "group", "title": "Group"},
          {"field": "pct", "title": "% with a schooling restriction", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "tick", "thickness": 3, "size": 30, "color": "#d94801"},
      "encoding": {
        "y": {"field": "group", "type": "nominal", "sort": ["All children", "Boys", "Girls"]},
        "x": {"datum": 7.8, "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 13, "fontWeight": "bold"},
      "encoding": {
        "y": {"field": "group", "type": "nominal", "sort": ["All children", "Boys", "Girls"]},
        "x": {"field": "pct", "type": "quantitative"},
        "text": {"field": "pct", "type": "quantitative", "format": ".1f"},
        "color": {"value": "black"}
      }
    }
  ]
}
