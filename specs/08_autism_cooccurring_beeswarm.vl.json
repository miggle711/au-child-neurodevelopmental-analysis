{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Co-occurring characteristics among autistic Australians",
  "description": "ABS SDAC 2022: % of autistic people (all ages) also reporting each characteristic \u2014 shows autism rarely occurs in isolation (national data only, not age-restricted to children)",
  "width": 520,
  "height": 260,
  "data": {
    "url": "data/processed/abs_autism_cooccurring.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 260,
        "opacity": 0.85,
        "stroke": "black",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative",
          "title": "% of autistic people also reporting this",
          "scale": {
            "domain": [
              0,
              80
            ]
          }
        },
        "y": {
          "field": "y_pos",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "color": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges"
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "disability_type",
            "title": "Characteristic"
          },
          {
            "field": "pct",
            "title": "%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 9,
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative"
        },
        "y": {
          "field": "y_pos",
          "type": "quantitative"
        },
        "text": {
          "field": "disability_type"
        }
      }
    }
  ],
  "config": {
    "title": {
      "font": "Lora",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#2b2a26",
      "anchor": "start"
    },
    "axis": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "legend": {
      "labelFont": "Public Sans",
      "labelFontSize": 9.5,
      "labelColor": "#5c5a52",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600,
      "titleColor": "#2b2a26"
    },
    "header": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans",
      "titleFontSize": 10.5,
      "titleFontWeight": 600
    }
  }
}
